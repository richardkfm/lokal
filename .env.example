# lokal — environment configuration
#
# Copy to .env and adjust. lokal runs without any external service:
# no API keys, no third-party analytics, no model providers.

# Database. SQLite in development and for small self-hosted installs.
# PostgreSQL works by swapping the provider in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Public base URL, used for absolute links in shared reports.
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# lokal argues for data sovereignty, so it does not phone home during builds.
NEXT_TELEMETRY_DISABLED=1

# Optional: a human to contact about the plan.
#
# lokal produces a plan and stops; its capacity section often tells an
# organization they will need help carrying it out. Set these and a contact block
# appears on the landing page and at the end of the report, including the printed
# copy. Leave them unset and nothing is shown.
#
# Nothing is stored or sent — the block renders a mailto:, a tel: and a link.
# LOKAL_EXPERT_NAME and one way to reach the person are the minimum; the rest is
# optional. They are read per request, so changing them needs a restart, not a
# rebuild.
# LOKAL_EXPERT_NAME="Maria Schneider"
# LOKAL_EXPERT_ORG="Beispiel IT-Beratung GmbH"
# LOKAL_EXPERT_EMAIL="beratung@example.org"
# LOKAL_EXPERT_PHONE="+49 30 123456"
# LOKAL_EXPERT_URL="https://example.org/open-source-migration"
# LOKAL_EXPERT_NOTE="Begleitet Kommunen und Mittelstand bei Nextcloud- und Matrix-Einführungen."

# Legal links. lokal cannot write an Impressum, a Datenschutzerklärung or a
# Barrierefreiheitserklärung: they are declarations about you — your name, your
# address, your data-protection officer, your own conformance assessment. A
# placeholder would be worse than an absence, because a placeholder looks
# discharged.
#
# Point at the ones you already publish. Unset means the link is absent; the
# whole footer column disappears when none is set.
#
# LOKAL_LEGAL_IMPRINT_URL="https://example.org/impressum"
# LOKAL_LEGAL_PRIVACY_URL="https://example.org/datenschutz"
# LOKAL_LEGAL_ACCESSIBILITY_URL="https://example.org/barrierefreiheit"
